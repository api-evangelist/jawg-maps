                  "description": "(Required) The free-text query to geocode."
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Maximum number of results to return."
                },
                {
                  "disabled": false,
                  "key": "layers",
                  "value": "<string>",
                  "description": "Comma-separated feature layers to restrict the search to (e.g. address, venue, locality)."
