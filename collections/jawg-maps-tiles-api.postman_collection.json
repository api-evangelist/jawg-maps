          "id": "49180ed8-75ab-4d86-b7d2-7f0c7dcfce9f",
          "name": "Get a raster (PNG) map tile.",
          "request": {
            "name": "Get a raster (PNG) map tile.",
            "description": {
              "content": "Returns a raster map tile in the XYZ slippy-map scheme for the given hosted style. Append `@2x` before `.png` for retina tiles.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                ":styleId",
                ":z",
                ":x",
                "{{y}}.png"
              ],
              "host": [
                "tile",
                "jawg",
                "io"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access-token",
                  "value": "<string>",
                  "description": "(Required) Your Jawg access token."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Preferred label language (ISO 639-1)."
                },
                {
                  "disabled": false,
                  "key": "worldview",
                  "value": "<string>",
                  "description": "Worldview used to render disputed borders."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "styleId",
                  "description": "(Required) The hosted Jawg style identifier (e.g. jawg-sunny, jawg-streets, or a custom style ID)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "z",
                  "description": "(Required) Tile zoom level."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "x",
                  "description": "(Required) Tile column."
                }
              ]
            },
            "header": [
