{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jawg Maps Isochrone Static Maps API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access-token",
      "value": "{{access-token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Static Maps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Render a standalone static map image.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tile.jawg.io/static",
            "params": [
              {
                "name": "layer",
                "value": "jawg-sunny",
                "type": "query",
                "description": "The hosted style / layer to render (e.g. jawg-sunny)."
              },
              {
                "name": "center",
                "value": "48.856,2.351",
                "type": "query",
                "description": "Map center as \"lat,lon\"."
              },
              {
                "name": "zoom",
                "value": "12",
                "type": "query"
              },
              {
                "name": "size",
                "value": "400x300",
                "type": "query",
                "description": "Image size as \"widthxheight\" in pixels."
              },
              {
                "name": "format",
                "value": "",
                "type": "query"
              },
              {
                "name": "markers",
                "value": "",
                "type": "query",
                "description": "Marker overlays to render on the image."
              },
              {
                "name": "paths",
                "value": "",
                "type": "query",
                "description": "Path (polyline/polygon) overlays to render on the image."
              },
              {
                "name": "bearing",
                "value": "",
                "type": "query"
              },
              {
                "name": "pitch",
                "value": "",
                "type": "query"
              },
              {
                "name": "access-token",
                "value": "",
                "type": "query",
                "description": "Your Jawg access token."
              }
            ]
          },
          "docs": "Renders a static map image from a center, zoom, and size (or from an auto-fit set of features), optionally decorated with markers and paths."
        }
      ]
    }
  ],
  "bundled": true
}