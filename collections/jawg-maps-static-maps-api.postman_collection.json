            },
            "url": {
              "protocol": "https",
              "path": [
                "static"
              ],
              "host": [
                "api",
                "jawg",
                "io"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "layer",
                  "value": "<string>",
                  "description": "The hosted style / layer to render (e.g. jawg-sunny)."
                },
                {
                  "disabled": false,
                  "key": "center",
                  "value": "<string>",
                  "description": "Map center as \"lat,lon\"."
                },
                {
                  "disabled": false,
                  "key": "zoom",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<string>",
                  "description": "Image size as \"widthxheight\" in pixels."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "png"
                },
                {
                  "disabled": false,
                  "key": "markers",
                  "value": "<string>",
                  "description": "Marker overlays to render on the image."
                },
                {
                  "disabled": false,
                  "key": "paths",
                  "value": "<string>",
                  "description": "Path (polyline/polygon) overlays to render on the image."
                },
                {
                  "disabled": false,
                  "key": "bearing",
                  "value": "<double>"
                },
                {
                  "disabled": false,
                  "key": "pitch",
                  "value": "<double>"
                },
                {
                  "disabled": false,
                  "key": "access-token",
                  "value": "<string>",
                  "description": "(Required) Your Jawg access token."
                }
              ],
              "variable": []
